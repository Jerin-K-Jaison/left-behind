---
import Layout from '../layouts/Layout.astro';
const files=import.meta.glob('../data/*.json',{eager:true});
const missions=Object.values(files).map((f:any)=>f.default).filter((m:any)=>m?.slug).sort((a:any,b:any)=>a.name.localeCompare(b.name));
const labels:any={operational:'Operational',silent:'Silent / inactive',lost:'Lost contact',abandoned:'Left on site',decommissioned:'Decommissioned',reentered:'Re-entered',crashed:'Crashed'};
---
<Layout title="Spacecraft Behavior · Left Behind" description="Explore the known status and whereabouts of spacecraft, probes, stations and rovers.">
  <section class="feature-hero page-hero"><span class="eyebrow">04 · STATUS & WHEREABOUTS</span><h1>Where are they<br/><em>now?</em></h1><p>A field monitor for the machines we sent away. Their status is not all the same: some still work, some are parked on other worlds, and some have become part of the history of spaceflight.</p></section>
  <div class="status-summary"><div><strong>{missions.length}</strong><span>tracked archive entries</span></div><div><strong>8</strong><span>planetary destinations and beyond</span></div><div><strong>01</strong><span>living archive · not live telemetry</span></div></div>
  <div class="behavior-tools"><label for="statusFilter">Filter by status</label><select id="statusFilter"><option value="all">All known statuses</option>{Object.entries(labels).map(([k,v])=><option value={k}>{v as string}</option>)}</select><label for="behaviorSearch">Find a spacecraft</label><input id="behaviorSearch" type="search" placeholder="Mission, agency or destination…"/></div>
  <section class="behavior-grid" id="behaviorGrid">{missions.map((m:any)=><a class="behavior-card" href={`/story/${m.slug}`} data-status={m.status??'silent'} data-search={`${m.name} ${m.kind} ${m.agency??''} ${m.place??''}`.toLowerCase()}><img src={m.image??`/images/${m.slug}.svg`} alt={m.imageAlt??m.name} loading="lazy"/><div><span class={`status-pill status-${m.status??'silent'}`}>{labels[m.status??'silent']??'Archived'}</span><h2>{m.name}</h2><p>{m.place??'Space'} · {m.agency??'Space programme'}</p><small>{m.lastSignal??`${m.start}–${m.end}`}</small></div></a>)}</section>
  <p id="behaviorEmpty" hidden>No spacecraft match those filters.</p>
  <p class="editorial-note">This is a curated historical archive, not a live orbital tracking service. Current positions and operational states can change; follow each mission’s linked agency record for the latest confirmed information.</p>
  <footer class="archive-footer"><a href="/last-transmission">← The Last Transmission</a><a href="/image-album">Browse mission photographs →</a></footer>
</Layout>
<script>
const status=document.querySelector<HTMLSelectElement>('#statusFilter')!,search=document.querySelector<HTMLInputElement>('#behaviorSearch')!,cards=[...document.querySelectorAll<HTMLElement>('.behavior-card')],empty=document.querySelector<HTMLElement>('#behaviorEmpty')!;
function filter(){let n=0;cards.forEach(c=>{const ok=(status.value==='all'||c.dataset.status===status.value)&&(c.dataset.search??'').includes(search.value.toLowerCase().trim());c.hidden=!ok;if(ok)n++;});empty.hidden=n>0;}
status.addEventListener('change',filter);search.addEventListener('input',filter);
</script>
