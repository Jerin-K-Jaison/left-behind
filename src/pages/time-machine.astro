---
import Layout from '../layouts/Layout.astro';
const events=[
 {year:1957,title:'Sputnik 1',agency:'USSR',text:'A polished sphere and four antennas. The first artificial satellite made the space age impossible to ignore.',kind:'satellite'},
 {year:1961,title:'First human in space',agency:'USSR',text:'Yuri Gagarin completed one orbit of Earth aboard Vostok 1.',kind:'human'},
 {year:1969,title:'Apollo 11',agency:'NASA',text:'Humans walked on the Moon. The landing site became a place of scientific history — and enduring human traces.',kind:'moon'},
 {year:1971,title:'First space station',agency:'USSR',text:'Salyut 1 opened a new chapter in long-duration human activity in orbit.',kind:'station'},
 {year:1977,title:'Voyager launches',agency:'NASA',text:'Two probes began a grand tour of the outer planets, then continued toward interstellar space.',kind:'deep'},
 {year:1997,title:'Sojourner on Mars',agency:'NASA',text:'A small rover explored the Martian surface and helped pave the way for a new generation of mobile explorers.',kind:'mars'},
 {year:2008,title:'Chandrayaan-1',agency:'ISRO',text:'India’s first lunar mission helped strengthen evidence for water molecules on the Moon.',kind:'moon'},
 {year:2013,title:'Mars Orbiter Mission',agency:'ISRO',text:'Mangalyaan made India the first country to reach Mars orbit on its first attempt.',kind:'mars'},
 {year:2021,title:'James Webb begins its journey',agency:'NASA / ESA / CSA',text:'A new observatory travelled to its operating orbit to study the earliest galaxies and distant worlds.',kind:'deep'},
 {year:2023,title:'Chandrayaan-3',agency:'ISRO',text:'India achieved a successful soft landing near the lunar south polar region.',kind:'moon'}
];
---
<Layout title="Mission Time Machine · Left Behind" description="Travel through milestones in humanity's exploration of space.">
  <section class="feature-hero page-hero"><span class="eyebrow">07 · A HISTORY IN MOTION</span><h1>Time moves.<br/><em>Footprints remain.</em></h1><p>Drag the years forward and watch the story of space exploration unfold — one launch, landing and leap at a time.</p></section>
  <section class="time-machine"><div class="time-readout"><span>SELECTED YEAR</span><strong id="timeYear">1957</strong></div><input id="timeSlider" type="range" min="1957" max="2026" value="1957" step="1" aria-label="Choose a year in space exploration"/><div class="time-ends"><span>1957 · Sputnik</span><span>2026 · Today</span></div><div class="time-event" id="timeEvent" aria-live="polite"><span class="event-kind">THE SPACE AGE BEGINS</span><h2>Sputnik 1</h2><p>A polished sphere and four antennas. The first artificial satellite made the space age impossible to ignore.</p><small>USSR · 1957</small></div></section>
  <section class="timeline-list"><h2>Milestones along the way</h2>{events.map((e,i)=><article class="timeline-item" data-year={e.year}><span class="timeline-year">{e.year}</span><div><h3>{e.title}</h3><p>{e.text}</p><small>{e.agency}</small></div></article>)}</section>
  <footer class="archive-footer"><a href="/animation">← Animation Lab</a><a href="/about">About the archive →</a></footer>
</Layout>
<script>
const events=[...document.querySelectorAll<HTMLElement>('.timeline-item')].map(el=>({year:Number(el.dataset.year),title:el.querySelector('h3')?.textContent??'',text:el.querySelector('p')?.textContent??'',agency:el.querySelector('small')?.textContent??'',kind:el.querySelector('.timeline-year')?.textContent??''}));
const slider=document.querySelector<HTMLInputElement>('#timeSlider')!,year=document.querySelector<HTMLElement>('#timeYear')!,panel=document.querySelector<HTMLElement>('#timeEvent')!;
function update(){const y=Number(slider.value);year.textContent=String(y);const e=[...events].filter(x=>x.year<=y).pop()??events[0];panel.innerHTML=`<span class="event-kind">${e.year} · MILESTONE</span><h2>${e.title}</h2><p>${e.text}</p><small>${e.agency} · ${e.year}</small>`;document.querySelectorAll<HTMLElement>('.timeline-item').forEach(el=>el.classList.toggle('reached',Number(el.dataset.year)<=y));}
slider.addEventListener('input',update);update();
</script>
