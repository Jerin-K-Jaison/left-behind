---
import Layout from '../layouts/Layout.astro';
interface Machine {
  name:string; slug:string; kind:string; start:number; end:number; tagline:string; cause:string;
  x:number; y:number; status?:string; agency?:string; category?:string; place?:string;
}
const files = import.meta.glob<{default:Machine}>('../data/*.json',{eager:true});
const machines:Machine[] = Object.values(files).map(f=>f.default).filter(m=>m?.slug).sort((a,b)=>a.start-b.start);
const causes:Record<string,string>={power:'Power loss',damage:'Damage / failure',planned:'Planned ending',distance:'Distance / signal',orbit:'Orbital decay'};
const statuses:Record<string,string>={operational:'Operational',silent:'Silent',lost:'Lost',abandoned:'Left on site',decommissioned:'Decommissioned',reentered:'Re-entered',crashed:'Crashed'};
const years = machines.flatMap(m=>[m.start,m.end]);
const minYear=Math.min(...years), maxYear=2026;
---
<Layout title="Left Behind — An Atlas of Humanity in Space" description="An interactive archive of spacecraft, satellites, landers, rovers and stations that humanity has left across the Solar System and beyond.">
  <div class="eyebrow"><span class="eyebrow-line"></span> A HUMAN FOOTPRINT ACROSS THE SOLAR SYSTEM</div>
  <h1><span class="l1">Our little corner</span><span class="l2">of an enormous universe.</span></h1>
  <p class="sub hero-sub">Start with the Sun. Follow the worlds outward. Find the machines that travelled there — and the traces they left behind.</p>

  <section class="stage" aria-label="Schematic solar system archive">
    <div class="map-heading"><div><span class="section-kicker">THE SPACE ATLAS</span><h2>Where our machines went</h2></div><span class="schematic-note">SCHEMATIC · NOT TO SCALE</span></div>
    <div class="map-wrap">
      <svg class="map" viewBox="0 0 140 62" role="img" aria-label="Illustrated Solar System showing the Sun and all eight planets, with mission satellite markers near destinations.">
        <defs>
          <radialGradient id="sunGlow"><stop offset="0%" stop-color="#fff0a8" stop-opacity=".95"/><stop offset="45%" stop-color="#ffb84d" stop-opacity=".45"/><stop offset="100%" stop-color="#ff9d36" stop-opacity="0"/></radialGradient>
          <linearGradient id="satPanel" x1="0" x2="1"><stop stop-color="#a8e7ff"/><stop offset="1" stop-color="#397ca8"/></linearGradient>
          <g id="satelliteGlyph" stroke="#d9f2ff" stroke-width=".28" stroke-linejoin="round">
            <rect x="-.72" y="-.62" width="1.44" height="1.24" rx=".2" fill="#eaf6ff"/>
            <path d="M-.82-.48h-1.45v.96h1.45M.82-.48h1.45v.96H.82" fill="url(#satPanel)" stroke="#8bd7ff"/>
            <path d="M-1.55 0h.73M.82 0h.73M0-.62v-.58M-.28-.62L0-1.2l.28.58" fill="none"/>
            <circle r=".2" fill="#38516d" stroke="none"/>
          </g>
        </defs>
        <rect width="140" height="62" fill="transparent"/>
        <g class="solar-orbits">
          <ellipse cx="8" cy="30" rx="9" ry="8"/><ellipse cx="8" cy="30" rx="15" ry="12"/><ellipse cx="8" cy="30" rx="22" ry="16"/><ellipse cx="8" cy="30" rx="31" ry="21"/><ellipse cx="8" cy="30" rx="43" ry="25"/><ellipse cx="8" cy="30" rx="57" ry="28"/><ellipse cx="8" cy="30" rx="73" ry="30"/><ellipse cx="8" cy="30" rx="91" ry="32"/><ellipse cx="8" cy="30" rx="105" ry="34"/>
        </g>
        <g class="sun-body"><circle cx="8" cy="30" r="9" fill="url(#sunGlow)"/><circle cx="8" cy="30" r="3.1" fill="#ffc45c"/><path d="M8 25.8v-1.1M8 35.2v1.1M3.8 30H2.7M13.2 30h1.1M5 27l-.8-.8M11.8 33.8l.8.8M11 27l.8-.8M5 33l-.8.8" stroke="#ffe5a0" stroke-width=".35"/></g>
        <text class="label" x="8" y="43">Sun</text>
        <g class="planet mercury"><circle cx="17" cy="30" r=".85" fill="#9a9da6"/><text class="label" x="17" y="38">Mercury</text></g>
        <g class="planet venus"><circle cx="23" cy="30" r="1.35" fill="#d9b47d"/><path d="M22.2 29.4q1.3-.8 2 .3" fill="none" stroke="#f4d39a" stroke-width=".3"/><text class="label" x="23" y="41">Venus</text></g>
        <g class="planet earth"><circle cx="30" cy="30" r="1.65" fill="#347fca"/><path d="M29 29.3l.7-.6.5.2-.1.6.6.4-.4.7-.8-.1-.4.5-.5-.7z" fill="#7cc58b"/><circle cx="32.4" cy="27.9" r=".38" fill="#c9d8e8"/><text class="label" x="30" y="41">Earth</text></g>
        <g class="planet mars"><circle cx="40" cy="30" r="1.25" fill="#d66d4f"/><path d="M39.2 29.5q.8-.6 1.5.1" stroke="#f6ad86" stroke-width=".3" fill="none"/><text class="label" x="40" y="40">Mars</text></g>
        <g class="planet jupiter"><circle cx="57" cy="30" r="3.2" fill="#c99b70"/><path d="M54.2 29q2.8.8 5.6 0M54.1 30.4q2.9.8 5.8 0M55 31.7q2 .5 4.2-.1" stroke="#f0d1a8" stroke-width=".38" fill="none"/><text class="label" x="57" y="40">Jupiter</text></g>
        <g class="planet saturn"><ellipse cx="76" cy="30" rx="5.1" ry="1.45" transform="rotate(-18 76 30)" fill="none" stroke="#d8bd83" stroke-width=".85"/><circle cx="76" cy="30" r="2.25" fill="#d8b878"/><path d="M74 29.7q2 .6 4 .1" stroke="#f2dfb8" stroke-width=".35" fill="none"/><text class="label" x="76" y="40">Saturn</text></g>
        <g class="planet uranus"><ellipse cx="94" cy="30" rx="2.7" ry=".75" transform="rotate(78 94 30)" fill="none" stroke="#8dd9dc" stroke-width=".35"/><circle cx="94" cy="30" r="1.8" fill="#83cdd2"/><text class="label" x="94" y="40">Uranus</text></g>
        <g class="planet neptune"><circle cx="112" cy="30" r="1.75" fill="#477bd5"/><path d="M110.8 29.8q1.3-.5 2.3.1" stroke="#a6c8ff" stroke-width=".35" fill="none"/><text class="label" x="112" y="40">Neptune</text></g>
        <text class="label system-label" x="129" y="30">Beyond</text>
        {machines.map(m=>(
          <a class="mission-marker" href={`/story/${m.slug}`} aria-label={`${m.name} — ${statuses[m.status ?? 'silent'] ?? 'Mission'}`} data-cause-item={m.cause} data-status-item={m.status ?? 'silent'} data-name={m.name} data-meta={`${m.kind} · ${m.start}–${m.end}`}>
            <circle class="marker-halo" cx={m.x} cy={m.y} r="2.5" data-start={m.start} data-end={m.end}/>
            <circle class="marker-hit" cx={m.x} cy={m.y} r="2.8"/>
            <g class="satellite-marker" transform={`translate(${m.x} ${m.y})`} data-start={m.start} data-end={m.end}><use href="#satelliteGlyph"/></g>
            <title>{m.name}</title>
          </a>
        ))}
      </svg>
      <div class="tip" role="presentation" aria-hidden="true"><strong></strong><span></span></div>
    </div>
    <div class="map-legend"><span><i class="legend-sat"></i> Spacecraft / mission marker</span><span><i class="legend-planet"></i> Planet</span><span><i class="legend-live"></i> Operational</span><span><i class="legend-silent"></i> Inactive / ended</span></div>
    <div class="deck">
      <label for="year">Explore the timeline <strong id="yearLabel">2026</strong></label>
      <input id="year" class="slider" type="range" min={minYear} max={maxYear} value={maxYear}/>
      <p class="sub"><span>Move through the years to see which missions had launched, were operating, or had already gone silent.</span></p>
    </div>
  </section>

  <section class="continue-reading" aria-label="Continue exploring">
    <span class="section-kicker">THE JOURNEY DOESN’T END HERE</span>
    <h2>Every world has a story.<br/><em>Every silence leaves a trace.</em></h2>
    <p>Follow the missions beyond the orbits — the machines that went quiet, the worlds they touched, and the pieces of humanity still travelling through space.</p>
    <a class="continue-link" href="/explore-the-darkness">Continue reading <span aria-hidden="true">↗</span></a>
  </section>
</Layout>

<script>
  const slider=document.querySelector<HTMLInputElement>('#year')!;
  const label=document.querySelector<HTMLElement>('#yearLabel')!;
  const timed=document.querySelectorAll<SVGElement>('.mission-marker [data-start]');
  const reduceMotion=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function paint(y:number){
    label.textContent=String(y); const min=Number(slider.min),max=Number(slider.max);
    slider.style.setProperty('--pct',`${((y-min)/(max-min))*100}%`);
    timed.forEach(el=>{const s=Number(el.dataset.start),e=Number(el.dataset.end);el.classList.toggle('future',y<s);el.classList.toggle('live',y>=s&&y<=e);el.classList.toggle('silent',y>e);});
  }
  slider.addEventListener('input',()=>paint(Number(slider.value)));
  paint(Number(slider.value));

  // One gentle orbital sweep when the visitor scrolls the atlas into view.
  // Planets return to their original, easy-to-select alignment and remain still.
  const planetSpecs=[
    {selector:'.mercury',rx:9,ry:4},{selector:'.venus',rx:15,ry:6},
    {selector:'.earth',rx:22,ry:8},{selector:'.mars',rx:32,ry:10},
    {selector:'.jupiter',rx:49,ry:13},{selector:'.saturn',rx:68,ry:16},
    {selector:'.uranus',rx:86,ry:19},{selector:'.neptune',rx:104,ry:22}
  ];
  const map=document.querySelector<SVGSVGElement>('.map')!;
  let orbitalPlayed=false, orbitalFrame=0;
  function playOrbitalSweep(){
    if(orbitalPlayed||reduceMotion)return;
    orbitalPlayed=true;
    const duration=4600,started=performance.now();
    const planets=planetSpecs.map(spec=>({el:map.querySelector<SVGGElement>(spec.selector)!,...spec}));
    const frame=(now:number)=>{
      const raw=Math.min((now-started)/duration,1);
      const eased=raw<.5?4*raw*raw*raw:1-Math.pow(-2*raw+2,3)/2;
      planets.forEach(({el,rx,ry})=>{
        const angle=eased*Math.PI*2;
        const dx=rx*(Math.cos(angle)-1),dy=ry*Math.sin(angle);
        el.setAttribute('transform',`translate(${dx.toFixed(3)} ${dy.toFixed(3)})`);
      });
      if(raw<1)orbitalFrame=requestAnimationFrame(frame);
      else planets.forEach(({el})=>el.removeAttribute('transform'));
    };
    orbitalFrame=requestAnimationFrame(frame);
  }
  const atlasObserver=new IntersectionObserver(entries=>{
    if(entries.some(entry=>entry.isIntersecting)){playOrbitalSweep();atlasObserver.disconnect();}
  },{threshold:.28});
  atlasObserver.observe(map);
  const wrap=document.querySelector<HTMLElement>('.map-wrap')!,tip=document.querySelector<HTMLElement>('.tip')!,tipName=tip.querySelector('strong')!,tipMeta=tip.querySelector('span')!;
  function showTip(a:SVGAElement){const marker=a.querySelector('.satellite-marker');if(!marker)return;const c=marker.getBoundingClientRect(),w=wrap.getBoundingClientRect();tipName.textContent=a.dataset.name??'';tipMeta.textContent=a.dataset.meta??'';const half=tip.offsetWidth/2,x=c.left-w.left+c.width/2;tip.style.left=`${Math.min(Math.max(x,half+8),w.width-half-8)}px`;tip.style.top=`${Math.max(8,c.top-w.top-8)}px`;tip.classList.add('show');}
  function hideTip(){tip.classList.remove('show');}
  document.querySelectorAll<SVGAElement>('.mission-marker').forEach(a=>{a.addEventListener('pointerenter',()=>showTip(a));a.addEventListener('pointerleave',hideTip);a.addEventListener('focus',()=>showTip(a));a.addEventListener('blur',hideTip);});

</script>
