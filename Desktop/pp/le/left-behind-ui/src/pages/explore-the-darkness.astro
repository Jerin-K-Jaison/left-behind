---
import Layout from '../layouts/Layout.astro';
interface Entry { name:string; slug:string; kind:string; start:number; end:number; tagline:string; status?:string; agency?:string; place?:string; category?:string; image?:string; imageAlt?:string; }
const files = import.meta.glob<{default:Entry}>('../data/*.json',{eager:true});
const entries:Entry[] = Object.values(files).map(f=>f.default).filter(x=>x?.slug).sort((a,b)=>a.name.localeCompare(b.name));
const statusNames:Record<string,string>={operational:'Still listening',silent:'Fallen quiet',lost:'Lost signal',abandoned:'Left on site',decommissioned:'Retired',reentered:'Returned to Earth',crashed:'Impact / crash'};
---
<Layout title="Explore the Darkness · Left Behind" description="An illustrated field guide to the spacecraft and machines that travelled into space.">
  <section class="archive-intro">
    <span class="eyebrow"><span class="eyebrow-line"></span> THE FIELD GUIDE · {entries.length} ENTRIES</span>
    <h1><span class="l1">Explore the</span><span class="l2">Darkness.</span></h1>
    <p class="sub hero-sub">A field guide to the machines that crossed the dark: some still at work, some waiting in silence, and some whose final chapter is still being written.</p>
    <div class="archive-tools"><label class="search-label" for="dictionarySearch">Find an entry</label><input id="dictionarySearch" class="mission-search" type="search" placeholder="Search a mission, world, agency or machine…" autocomplete="off"/><span class="result-count" id="entryCount">{entries.length} ENTRIES</span></div>
  </section>
  <div class="dictionary" id="dictionary">
    {entries.map((m)=> (
      <a class="dictionary-entry" href={`/story/${m.slug}`} data-entry={`${m.name} ${m.kind} ${m.agency??''} ${m.place??''} ${m.tagline}`.toLowerCase()}>
        <div class="entry-art" data-nasa-query={`${m.name} ${m.kind}`}><img src={m.image ?? `/images/${m.slug}.svg`} alt={m.imageAlt ?? `Illustration of ${m.name}`} loading="lazy"/><span class="art-index">{String(entries.indexOf(m)+1).padStart(2,'0')}</span></div>
        <div class="entry-copy"><div class="entry-meta"><span>{m.agency ?? 'SPACE PROGRAMME'}</span><span>{m.start} — {m.end}</span></div><h2>{m.name}</h2><p class="entry-kind">{m.category ?? m.kind} · {m.place ?? 'Space'}</p><p class="entry-description">{m.tagline}</p><div class="entry-foot"><span class={`status-pill status-${m.status??'silent'}`}>{statusNames[m.status??'silent']??'Archived'}</span><span class="entry-read">Read the field note <b>↗</b></span></div></div>
      </a>
    ))}
  </div>
  <p class="dictionary-empty" id="dictionaryEmpty" hidden>No entries found. Try another name, world or agency.</p>
  <footer class="archive-footer"><span>LEFT BEHIND · AN ARCHIVE OF HUMAN PRESENCE IN SPACE</span><a href="/image-album">Continue to the Image Album →</a><a href="/">Return to the solar system ↑</a></footer>
</Layout>
<script>
  document.querySelectorAll<HTMLElement>('.entry-art[data-nasa-query]').forEach(async (art) => {
    try {
      const q = art.dataset.nasaQuery ?? 'spacecraft';
      const response = await fetch(`https://images-api.nasa.gov/search?q=${encodeURIComponent(q)}&media_type=image&page_size=5`);
      if (!response.ok) return;
      const data = await response.json();
      const item = (data.collection?.items ?? []).find((x:any) => x.links?.some((l:any) => l.render === 'image'));
      if (!item) return;
      const url = item.links.find((l:any) => l.render === 'image').href;
      const img = art.querySelector('img');
      if (img) { img.src = url; img.alt = item.data?.[0]?.title ?? `${q} mission photograph`; }
    } catch { /* Keep the bundled illustrated fallback when the NASA service is unavailable. */ }
  });
  const input=document.querySelector<HTMLInputElement>('#dictionarySearch')!;
  const rows=[...document.querySelectorAll<HTMLElement>('.dictionary-entry')];
  const count=document.querySelector<HTMLElement>('#entryCount')!;
  const empty=document.querySelector<HTMLElement>('#dictionaryEmpty')!;
  input.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let n=0;rows.forEach(row=>{const show=(row.dataset.entry??'').includes(q);row.hidden=!show;if(show)n++;});count.textContent=`${n} ${n===1?'ENTRY':'ENTRIES'}`;empty.hidden=n!==0;});
</script>
