---
import Layout from '../layouts/Layout.astro';
---
<Layout title="The Image Album · Left Behind" description="A visual collection of spacecraft, planetary missions, launches and exploration.">
  <div class="image-album-page">
    <header class="album-hero"><span class="eyebrow">THE VISUAL ARCHIVE · NASA IMAGE LIBRARY</span><h1>Moments from<br/><em>the great beyond.</em></h1><p>Launch towers trembling with fire. Machines crossing alien ground. Worlds seen close for the first time. A photographic companion to the stories in Left Behind.</p></header>
    <nav class="album-filters" aria-label="Filter image collection"><button class="active" data-topic="all">All frames</button><button data-topic="Mars">Mars</button><button data-topic="Moon">Moon</button><button data-topic="Voyager">Deep space</button><button data-topic="launch">Launches</button><button data-topic="Hubble">Observatories</button></nav>
    <section id="albumGrid" class="album-grid" aria-live="polite"><p class="photo-loading">Opening the photographic archive…</p></section>
    <p class="album-credit">Images are retrieved from NASA’s public Image and Video Library. Each frame links to its original NASA record. Availability depends on the archive connection.</p>
    <footer class="archive-footer"><a href="/explore-the-darkness">← Explore the mission field guide</a><a href="/about">About this project →</a><a href="/">Return to the solar system ↑</a></footer>
  </div>
</Layout>
<script>
  const grid = document.querySelector<HTMLElement>('#albumGrid')!;
  const topics = ['Mars rover mission','Apollo Moon mission','Voyager spacecraft','NASA rocket launch','Hubble Space Telescope','Cassini Saturn mission','International Space Station','Chandrayaan lunar mission','Perseverance rover','Space Shuttle launch','Pioneer spacecraft','James Webb Space Telescope'];
  let allFrames:any[] = [];
  async function loadAlbum() {
    try {
      const groups = await Promise.all(topics.map(async q => {
        const r = await fetch(`https://images-api.nasa.gov/search?q=${encodeURIComponent(q)}&media_type=image&page_size=8`);
        if (!r.ok) return [];
        const d = await r.json();
        return (d.collection?.items ?? []).filter((x:any) => x.links?.some((l:any) => l.render === 'image')).slice(0,3);
      }));
      const seen = new Set<string>();
      allFrames = groups.flat().filter((x:any) => { const id=x.data?.[0]?.nasa_id; if(!id || seen.has(id)) return false; seen.add(id); return true; });
      render('all');
    } catch { grid.innerHTML = '<p>The NASA image archive is temporarily unreachable. Please try again, or browse <a href="https://images.nasa.gov/" target="_blank" rel="noopener">images.nasa.gov</a>.</p>'; }
  }
  function render(topic:string) {
    const list = topic==='all' ? allFrames : allFrames.filter((x:any) => `${x.data?.[0]?.title} ${x.data?.[0]?.description}`.toLowerCase().includes(topic.toLowerCase()));
    grid.innerHTML = list.map((x:any,i:number) => {
      const m=x.data?.[0]??{}, src=x.links.find((l:any)=>l.render==='image')?.href;
      const title=(m.title??'Mission photograph').replace(/[<>]/g,'');
      const desc=(m.description??'').replace(/<[^>]*>/g,' ').replace(/[<>]/g,'').slice(0,240);
      return `<figure class="album-frame ${i%7===0?'album-feature':''}"><a href="${m.nasa_id?`https://images.nasa.gov/details/${m.nasa_id}`:src}" target="_blank" rel="noopener"><img loading="lazy" src="${src}" alt="${title.replace(/"/g,'&quot;')}"></a><figcaption><span class="frame-index">FRAME ${String(i+1).padStart(2,'0')}</span><h2>${title}</h2><p>${desc}</p><a class="frame-source" href="${m.nasa_id?`https://images.nasa.gov/details/${m.nasa_id}`:'https://images.nasa.gov/'}" target="_blank" rel="noopener">View NASA record ↗</a></figcaption></figure>`;
    }).join('') || '<p>No images matched this collection. Choose “All frames” to browse everything.</p>';
  }
  document.querySelectorAll<HTMLButtonElement>('.album-filters button').forEach(b=>b.addEventListener('click',()=>{document.querySelector('.album-filters .active')?.classList.remove('active');b.classList.add('active');render(b.dataset.topic??'all');}));
  loadAlbum();
</script>
