---
import Layout from '../layouts/Layout.astro';
const transmissions = [
 {name:'Beagle 2',date:'25 December 2003',place:'Mars',signal:'No confirmed communication after landing.',story:'Beagle 2 reached Mars, but its expected call never came. Years later, orbital images revealed the lander on the surface, partly deployed — a quiet answer to a long unanswered question.',note:'There is no verified final spoken message; the silence itself is the historical record.',source:'https://www.esa.int/Science_Exploration/Space_Science/Mars_Express/Beagle_2_found_on_Mars',image:'/images/beagle-2.svg'},
 {name:'Spirit',date:'22 March 2010',place:'Mars · Gusev Crater',signal:'Last communication received in March 2010.',story:'After six years of exploration, Spirit became trapped in soft soil. Winter darkness and dwindling power followed. Earth kept calling; the rover did not answer again.',note:'NASA ended recovery efforts in May 2011. The final communication date is commonly recorded as 22 March 2010.',source:'https://science.nasa.gov/mission/mer-spirit/',image:'/images/spirit.svg'},
 {name:'Opportunity',date:'10 June 2018',place:'Mars · Perseverance Valley',signal:'Last successful communication before the 2018 global dust storm.',story:'A planet-wide dust storm swallowed the sunlight Opportunity needed. The rover sent its final transmission in June. Months of listening followed before NASA declared the mission complete.',note:'The final received transmission was on 10 June 2018; the mission was declared complete in February 2019.',source:'https://science.nasa.gov/mission/mer-opportunity/',image:'/images/opportunity.svg'},
 {name:'Cassini',date:'15 September 2017',place:'Saturn',signal:'A planned final transmission during atmospheric entry.',story:'Cassini did not vanish by accident. Engineers guided it into Saturn to protect potentially habitable moons. Its signal continued almost to the end, arriving at Earth as the spacecraft entered the planet’s atmosphere.',note:'This was a deliberate mission ending, not an unexplained loss of contact.',source:'https://science.nasa.gov/mission/cassini/',image:'/images/cassini.svg'},
 {name:'Chandrayaan-1',date:'August 2009',place:'Lunar orbit',signal:'Communication lost; mission contact ended.',story:'India’s first lunar explorer had already transformed our understanding of the Moon. Then contact was lost. Years later, NASA radar observations helped locate the spacecraft still orbiting the Moon.',note:'ISRO announced loss of communication in August 2009; the spacecraft was later detected in lunar orbit.',source:'https://www.isro.gov.in/Chandrayaan1.html',image:'/images/chandrayaan-1.svg'},
 {name:'Voyager 1',date:'Still transmitting',place:'Interstellar space',signal:'A faint radio link still reaches Earth.',story:'The signal is astonishingly weak by the time it arrives. It has crossed billions of kilometres, carrying measurements from a region no other human-made spacecraft has explored directly.',note:'This is an ongoing mission, included here as a story about listening across extraordinary distance.',source:'https://science.nasa.gov/mission/voyager/',image:'/images/voyager-1.svg'}
];
---
<Layout title="The Last Transmission · Left Behind" description="Stories of final signals, lost contact and deliberate farewells from spacecraft.">
  <section class="feature-hero page-hero"><span class="eyebrow">03 · SIGNALS FROM THE EDGE</span><h1>The Last<br/><em>Transmission.</em></h1><p>Across the dark, Earth keeps listening. Some spacecraft answer. Some fall silent. A few are given a final goodbye on purpose.</p></section>
  <section class="transmission-list">
    {transmissions.map((t,i)=><article class="transmission-entry"><div class="transmission-art"><img src={t.image} alt={`${t.name} spacecraft illustration`} loading="lazy"/><span>RECORD {String(i+1).padStart(2,'0')}</span></div><div class="transmission-copy"><div class="entry-meta"><span>{t.place}</span><span>{t.date}</span></div><h2>{t.name}</h2><p class="signal-line">{t.signal}</p><p>{t.story}</p><p class="fact-note">{t.note}</p><a href={t.source} target="_blank" rel="noopener">Read the mission record ↗</a></div></article>)}
  </section>
  <p class="editorial-note">A note on accuracy: where no final message was recorded, this page describes the documented loss of contact rather than inventing dialogue or a last transmission.</p>
  <footer class="archive-footer"><a href="/explore-the-darkness">← Explore all missions</a><a href="/spacecraft-behavior">Where are they now? →</a></footer>
</Layout>
